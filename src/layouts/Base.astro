---
import '../styles/global.css';
import displayFont from '../assets/fonts/Literata72pt-Bold.woff2?url';
import textFont from '../assets/fonts/AtkinsonHyperlegibleNext-Regular.woff2?url';
import MarkerPicker from '../components/MarkerPicker.astro';
import { MARKER_KEY, MARKERS, REPO_URL, SITE_REPO_URL } from '../config';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const markerIds = MARKERS.map((m) => m.id);

const NAV = [
  { id: 'principe', label: 'Le principe' },
  { id: 'fonctionnement', label: 'Comment ça marche' },
  { id: 'parlement', label: 'Scrutins' },
  { id: 'valeurs', label: 'Valeurs' },
  { id: 'methode', label: 'Méthode' },
  { id: 'open-source', label: 'Open source' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F6F7F5" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <script is:inline define:vars={{ markerIds, MARKER_KEY }}>
      // Surligneur du lecteur appliqué avant l'affichage ; sans choix enregistré, un tirage au hasard à chaque visite.
      let marker = null;
      try {
        marker = localStorage.getItem(MARKER_KEY);
      } catch {}
      if (!markerIds.includes(marker)) marker = markerIds[Math.floor(Math.random() * markerIds.length)];
      document.documentElement.dataset.marker = marker;
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>

    <header class="bar">
      <a class="brand" href={`${base}/`} aria-label="élire, accueil">
        {/* Logo de l'app (elire-app/assets/brand/mark.svg) : la France d'un trait de feutre, le « é » au centre ; cadré sur le dessin. */}
        <svg viewBox="122 130 738 718" width="30" height="29" aria-hidden="true"><path d="M524.1 160.6C527.2 161.5 537.0 163.0 542.9 165.6C548.8 168.2 554.0 172.4 559.3 176.1C564.6 179.9 569.7 183.9 574.8 188.0C579.8 192.1 584.7 196.4 589.6 200.7C594.4 205.0 598.9 209.8 604.0 213.8C609.1 217.7 614.4 221.8 620.2 224.6C625.9 227.4 632.4 229.5 638.7 230.4C645.0 231.3 651.9 228.6 658.1 229.9C664.3 231.1 670.3 234.8 676.0 237.9C681.7 241.1 687.0 244.9 692.5 248.5C698.0 252.1 703.3 256.1 708.9 259.5C714.5 263.0 720.2 266.2 726.1 269.2C731.9 272.3 737.9 275.1 744.0 277.8C750.0 280.5 756.2 282.9 762.3 285.3C768.5 287.7 774.7 289.9 780.9 292.2C787.1 294.4 793.4 296.2 799.5 298.7C805.5 301.2 812.0 303.5 817.2 307.1C822.4 310.7 829.7 315.2 830.9 320.3C832.2 325.4 826.9 331.7 824.6 337.8C822.4 343.8 819.5 350.1 817.4 356.5C815.4 362.8 813.9 369.3 812.4 375.8C810.8 382.3 810.1 389.0 808.2 395.3C806.3 401.6 804.4 408.4 801.0 413.9C797.6 419.3 792.6 423.8 787.7 428.1C782.9 432.5 776.4 435.1 771.8 439.7C767.3 444.4 763.8 450.3 760.3 455.8C756.7 461.3 753.5 467.0 750.4 472.7C747.3 478.5 744.1 484.2 741.6 490.1C739.1 496.1 736.5 502.3 735.4 508.5C734.3 514.7 733.2 522.0 735.2 527.5C737.2 533.0 743.2 536.8 747.4 541.4C751.7 546.1 758.6 553.0 760.8 555.3" fill="none" stroke="#EADB3F" stroke-width="58" stroke-linecap="round" stroke-linejoin="round"/><path d="M735.2 527.5C737.2 529.8 743.2 536.8 747.4 541.4C751.7 546.1 757.3 550.0 760.8 555.3C764.4 560.6 767.1 566.8 769.0 573.0C770.8 579.1 771.2 585.8 771.8 592.3C772.5 598.8 772.8 605.3 772.9 611.9C773.0 618.4 772.6 625.0 772.3 631.5C772.0 638.1 770.9 644.6 771.3 651.2C771.6 657.7 772.5 664.5 774.4 670.8C776.3 677.1 779.4 683.2 782.6 689.1C785.7 695.0 791.7 700.3 793.4 706.1C795.1 711.9 795.6 718.9 792.8 723.7C790.0 728.4 782.1 731.1 776.7 734.7C771.3 738.3 765.7 741.8 760.2 745.3C754.7 748.8 749.4 752.7 743.6 755.8C737.8 758.8 731.9 762.0 725.7 763.7C719.4 765.4 712.5 767.0 706.3 766.0C700.1 765.0 694.5 760.0 688.3 757.7C682.1 755.5 675.6 754.0 669.2 752.4C662.8 750.9 656.2 749.8 649.8 748.4C643.3 747.1 636.8 744.8 630.4 744.3C623.9 743.7 617.2 743.3 611.1 745.0C605.0 746.7 599.1 750.4 593.9 754.2C588.7 758.0 583.9 762.8 580.0 767.8C576.2 772.9 572.3 778.7 570.7 784.7C569.2 790.8 572.8 798.6 570.5 804.0C568.3 809.4 562.7 814.5 557.3 816.9C551.8 819.3 544.3 818.5 537.9 818.6C531.4 818.7 524.8 817.9 518.3 817.5C511.8 817.0 505.3 816.5 498.8 815.8C492.3 815.2 485.9 814.4 479.4 813.6C472.9 812.8 466.5 811.9 460.0 810.9C453.6 809.9 443.9 808.2 440.7 807.6" fill="none" stroke="#F2A7C3" stroke-width="58" stroke-linecap="round" stroke-linejoin="round"/><path d="M479.4 813.6C476.2 813.2 466.5 811.9 460.0 810.9C453.6 809.9 447.1 808.9 440.7 807.6C434.3 806.3 428.0 804.7 421.7 803.0C415.4 801.2 409.2 799.2 403.1 797.0C396.9 794.8 390.9 792.5 384.9 789.9C378.8 787.4 372.9 784.7 367.0 781.8C361.2 778.9 355.5 775.8 349.9 772.5C344.2 769.2 338.5 766.0 333.2 762.3C328.0 758.5 320.1 754.8 318.2 750.0C316.2 745.2 319.8 739.2 321.5 733.4C323.2 727.5 326.5 721.2 328.4 714.9C330.3 708.6 331.4 702.1 332.7 695.7C334.0 689.3 335.0 682.8 336.0 676.4C337.0 669.9 338.0 663.5 338.8 657.0C339.6 650.6 340.4 644.2 341.0 637.7C341.7 631.3 342.3 624.9 342.7 618.4C343.1 612.0 343.6 605.6 343.5 599.2C343.4 592.7 343.1 586.3 342.1 579.9C341.2 573.6 339.9 567.2 337.9 561.1C335.8 555.0 332.6 549.3 329.8 543.5C327.0 537.6 324.1 531.8 321.1 526.0C318.2 520.1 315.2 514.3 312.2 508.5C309.2 502.7 306.3 496.7 303.1 491.0C299.8 485.3 296.5 479.5 292.7 474.2C288.8 468.8 284.7 463.4 280.1 458.7C275.4 454.0 270.2 449.7 264.8 445.8C259.3 442.0 253.4 438.7 247.5 435.6C241.6 432.5 235.4 429.7 229.3 427.2C223.1 424.7 216.8 422.5 210.5 420.3C204.2 418.1 197.7 416.7 191.6 414.2C185.6 411.6 179.5 408.7 174.2 404.9C168.9 401.2 162.3 393.9 160.0 391.7" fill="none" stroke="#A8E0A1" stroke-width="58" stroke-linecap="round" stroke-linejoin="round"/><path d="M191.6 414.2C188.7 412.6 179.5 408.7 174.2 404.9C168.9 401.2 163.7 396.8 160.0 391.7C156.3 386.6 152.6 380.2 152.0 374.2C151.5 368.2 153.0 360.8 156.5 356.0C159.9 351.1 167.1 348.1 173.0 345.1C178.9 342.2 185.5 340.2 192.0 338.4C198.4 336.6 205.0 335.1 211.6 334.1C218.3 333.2 225.0 332.6 231.7 332.5C238.3 332.5 245.1 332.9 251.6 333.9C258.2 334.8 264.6 336.9 271.1 338.4C277.5 339.9 283.9 342.3 290.4 342.9C296.8 343.6 305.5 345.2 309.8 342.4C314.2 339.6 315.9 331.8 316.5 325.9C317.2 320.0 315.0 313.1 313.9 306.8C312.8 300.5 309.9 293.8 309.9 287.9C309.8 282.0 310.2 272.8 313.8 271.2C317.3 269.6 325.1 276.4 331.1 278.4C337.1 280.3 343.5 282.0 349.8 282.8C356.2 283.6 362.7 283.5 369.1 283.2C375.5 282.9 382.0 282.3 388.3 281.0C394.6 279.7 400.9 277.8 406.9 275.4C412.9 273.1 418.8 270.2 424.5 267.1C430.1 263.9 435.6 260.4 440.9 256.6C446.1 252.7 451.3 248.7 456.0 244.2C460.7 239.7 465.2 234.9 469.0 229.6C472.7 224.4 476.1 218.6 478.5 212.6C480.8 206.7 481.2 199.9 483.2 193.8C485.2 187.7 486.8 180.9 490.5 175.9C494.1 170.8 499.3 166.0 504.9 163.5C510.5 160.9 517.8 160.3 524.1 160.6C530.4 161.0 537.0 163.0 542.9 165.6C548.8 168.2 556.6 174.4 559.3 176.1" fill="none" stroke="#A9D3F5" stroke-width="58" stroke-linecap="round" stroke-linejoin="round"/><g transform="translate(512.0 492.0) scale(0.56) translate(-551.5 -505.8)"><path fill="#1C1E21" transform="translate(262 800) scale(1.07 -1.07)" d="M289 20Q259 3 225.5 0.5Q192 -2 163.0 9.5Q134 21 116 44Q106 57 97.0 85.5Q88 114 94 163Q100 209 122.5 256.0Q145 303 178.0 339.0Q211 375 250 388Q264 393 278.5 395.5Q293 398 317 396Q340 393 358.0 384.5Q376 376 384 366Q400 350 405.0 335.0Q410 320 409 306Q404 274 380.5 237.0Q357 200 315 182Q298 175 275.0 173.0Q252 171 212 179Q188 184 180.5 174.0Q173 164 174 135Q176 117 182.5 103.5Q189 90 207 85Q230 81 240.0 84.5Q250 88 265 95Q276 102 288.0 112.0Q300 122 308 127Q316 133 328 133Q339 132 349.0 121.0Q359 110 362 100Q362 87 340.5 62.0Q319 37 289 20ZM276 243Q283 246 296.5 257.0Q310 268 321.0 280.5Q332 293 332 300Q332 311 317.5 319.0Q303 327 280 322Q270 319 254.5 305.0Q239 291 226.0 275.5Q213 260 209 252Q214 245 237.5 242.0Q261 239 276 243ZM327 435Q318 440 315.0 456.0Q312 472 314 488Q315 493 327.5 508.5Q340 524 358.5 543.0Q377 562 395.5 577.5Q414 593 426 596Q440 597 452.0 582.5Q464 568 465 547Q465 533 448.0 518.0Q431 503 409.5 487.0Q388 471 374 453Q364 437 352.0 432.0Q340 427 327 435Z"/></g></svg>
        <span>élire</span>
      </a>

      <nav class="menu" aria-label="Sections">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={`${base}/#${item.id}`} data-spy={item.id}><span class="hl">{item.label}</span></a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="end">
        <MarkerPicker class="bar-picker" />
        <a class="gh hl" href={REPO_URL} rel="noopener">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          <span>GitHub</span>
        </a>
        <details class="burger">
          <summary aria-label="Menu des sections">Menu</summary>
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={`${base}/#${item.id}`}><span class="hl">{item.label}</span></a>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-inner">
        <p class="foot-claim">
          Aucun compte, aucun cookie, aucun traceur. élire n'est lié à aucun parti, à aucun candidat ni à l'État.
        </p>
        <ul class="foot-links">
          <li><a href={REPO_URL} rel="noopener"><span class="hl">Code de l'app</span></a></li>
          <li><a href={SITE_REPO_URL} rel="noopener"><span class="hl">Code du site</span></a></li>
          <li><a href={`${REPO_URL}/blob/main/CODE_OF_CONDUCT.md`} rel="noopener"><span class="hl">Code de conduite</span></a></li>
          <li><a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`} rel="noopener"><span class="hl">Contribuer</span></a></li>
          <li><a href={`${base}/mentions-legales`}><span class="hl">Mentions légales</span></a></li>
        </ul>
        <p class="foot-legal">Code sous licence MIT, données sous CC BY-SA 4.0.</p>
      </div>
    </footer>

    <button class="reading" type="button" aria-label="Remonter en haut de la page" data-reading aria-hidden="true" tabindex="-1">
      <span class="reading-name" data-reading-name>{NAV[0].label}</span>
      <svg viewBox="0 0 48 48" width="56" height="56" aria-hidden="true">
        <circle cx="24" cy="24" r="21" fill="none" stroke="var(--rule-soft)" stroke-width="4"></circle>
        <circle class="reading-fill" cx="24" cy="24" r="21" fill="none" stroke="var(--mark)" stroke-width="4" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 24 24)"></circle>
      </svg>
      <span class="reading-label num" data-reading-label>01</span>
      <svg class="reading-up" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 3 3 8m5-5 5 5M8 3v10" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>

    <script>
      import { MARKER_KEY } from '../config';

      const button = document.querySelector<HTMLButtonElement>('[data-reading]');
      const fill = document.querySelector<SVGCircleElement>('.reading-fill');
      const label = document.querySelector<HTMLElement>('[data-reading-label]');
      const name = document.querySelector<HTMLElement>('[data-reading-name]');
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
      const sections = links
        .map((a) => document.getElementById(a.dataset.spy ?? ''))
        .filter((s): s is HTMLElement => s !== null);

      // Indicateur de lecture : visible après le premier écran, se remplit au fil de la page.
      let ticking = false;
      const update = () => {
        ticking = false;
        const max = document.documentElement.scrollHeight - innerHeight;
        const ratio = max > 0 ? Math.min(1, scrollY / max) : 0;
        if (fill) fill.style.strokeDashoffset = String(100 - ratio * 100);
        if (button) {
          const show = scrollY > innerHeight * 0.6;
          button.classList.toggle('is-visible', show);
          button.setAttribute('aria-hidden', String(!show));
          button.tabIndex = show ? 0 : -1;
        }
        let current = -1;
        sections.forEach((s, i) => {
          if (s.getBoundingClientRect().top < innerHeight * 0.4) current = i;
        });
        links.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        const index = Math.max(current, 0);
        if (label) label.textContent = String(index + 1).padStart(2, '0');
        if (name) name.textContent = links[index]?.textContent?.trim() ?? '';
      };
      addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      addEventListener('resize', update);
      update();
      button?.addEventListener('click', () => {
        scrollTo({ top: 0 });
        document.querySelector<HTMLElement>('.brand')?.focus({ preventScroll: true });
      });

      // Choix du surligneur : enregistré sur l'appareil seulement, appliqué aux gestes à venir.
      const root = document.documentElement;
      const syncPickers = () =>
        document.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === root.dataset.marker)));
      document.addEventListener('click', (event) => {
        const pick = (event.target as Element).closest<HTMLElement>('[data-pick]');
        if (!pick?.dataset.pick) return;
        root.dataset.marker = pick.dataset.pick;
        try {
          localStorage.setItem(MARKER_KEY, pick.dataset.pick);
        } catch {}
        syncPickers();
      });
      syncPickers();

      // Menu mobile : se ferme après un choix.
      const burger = document.querySelector<HTMLDetailsElement>('.burger');
      burger?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => burger.removeAttribute('open')));
    </script>

    <style>
      .skip {
        position: absolute;
        left: 16px;
        top: -60px;
        z-index: 30;
        background: var(--ink);
        color: var(--sheet);
        padding: 10px 14px;
        border-radius: 8px;
        font-weight: 600;
      }
      .skip:focus {
        top: 12px;
      }

      .bar {
        position: sticky;
        top: 0;
        z-index: 20;
        height: 72px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 24px;
        padding: 0 var(--gutter);
        background: color-mix(in srgb, var(--paper) 94%, transparent);
        backdrop-filter: saturate(1.2) blur(8px);
        border-bottom: 1px solid var(--rule);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        justify-self: start;
        color: var(--ink);
        text-decoration: none;
        font-family: var(--font-title);
        font-weight: 700;
        font-size: 20px;
        letter-spacing: -0.2px;
        min-height: 44px;
      }

      .menu ul,
      .burger ul,
      .foot-links {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .menu ul {
        display: flex;
        gap: clamp(18px, 2.4vw, 36px);
      }

      .menu a,
      .burger a,
      .foot-links a {
        color: inherit;
        text-decoration: none;
      }
      .menu a {
        display: inline-block;
        padding: 12px 0;
        font-size: 15px;
        font-weight: 600;
      }
      /* Le survol du lien (zone tactile entière) déclenche le trait sur le libellé. */
      a:hover > .hl,
      a:focus-visible > .hl,
      a[aria-current='true'] > .hl {
        background-size: 100% 100%;
      }

      .end {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .gh {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 12px;
        border: 1px solid var(--ink);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        background-image: linear-gradient(var(--mark), var(--mark));
        background-size: 0% 100%;
      }
      .gh:hover,
      .gh:focus-visible {
        background-size: 100% 100%;
      }

      .burger {
        display: none;
        position: relative;
      }
      .burger summary {
        list-style: none;
        cursor: pointer;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 0 14px;
        border: 1px solid var(--rule);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        background: var(--sheet);
      }
      .burger summary::-webkit-details-marker {
        display: none;
      }
      .burger[open] summary {
        border-color: var(--ink);
      }
      .burger ul {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        min-width: 240px;
        background: var(--sheet);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        padding: 8px 18px;
        box-shadow: 0 12px 28px rgba(28, 30, 33, 0.12);
      }
      .burger li + li {
        border-top: 1px solid var(--rule-soft);
      }
      .burger a {
        display: inline-block;
        padding: 12px 0;
        font-weight: 600;
      }

      @media (max-width: 1080px) {
        .bar {
          grid-template-columns: 1fr auto;
        }
        .menu {
          display: none;
        }
        .burger {
          display: block;
        }
      }
      @media (max-width: 420px) {
        .gh span {
          display: none;
        }
      }
      /* Sélecteur d'en-tête : seulement quand la barre a la place (le bloc « Votre surligneur » reste toujours là). */
      .end :global(.bar-picker) {
        margin-right: 4px;
      }
      @media (max-width: 1320px) and (min-width: 1081px), (max-width: 560px) {
        .end :global(.bar-picker) {
          display: none;
        }
      }

      .foot {
        border-top: 1px solid var(--rule);
        padding: 48px var(--gutter) 64px;
      }
      .foot-inner {
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        gap: 18px;
      }
      .foot-claim {
        font-size: 17px;
        color: var(--ink-soft);
        max-width: 60ch;
      }
      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 28px;
      }
      .foot-links a {
        display: inline-block;
        padding: 8px 0;
        font-weight: 600;
        font-size: 15px;
      }
      .foot-legal {
        font-size: 13px;
        color: var(--graphite);
      }

      .reading {
        position: fixed;
        right: max(16px, env(safe-area-inset-right));
        bottom: max(16px, env(safe-area-inset-bottom));
        z-index: 25;
        height: 64px;
        display: grid;
        grid-template-columns: auto 64px;
        align-items: center;
        padding: 0 0 0 20px;
        border: 1px solid var(--rule);
        border-radius: 32px;
        font: inherit;
        background: var(--sheet);
        color: var(--ink);
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(28, 30, 33, 0.1);
        transition: transform var(--sweep), opacity var(--sweep);
      }
      .reading:not(.is-visible) {
        opacity: 0;
        transform: translateY(12px) scale(0.92);
        pointer-events: none;
      }
      .reading > svg,
      .reading > .reading-label {
        grid-row: 1;
        grid-column: 2;
        justify-self: center;
      }
      .reading-name {
        grid-row: 1;
        grid-column: 1;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        padding-right: 2px;
      }
      @media (max-width: 600px) {
        .reading {
          height: 52px;
          grid-template-columns: auto 52px;
          padding-left: 16px;
        }
        .reading > svg:first-of-type {
          width: 46px;
          height: 46px;
        }
        .reading-name {
          font-size: 13px;
        }
      }
      .reading-fill {
        transition: stroke-dashoffset 120ms linear;
      }
      .reading-label {
        font-size: 13px;
        font-weight: 700;
      }
      .reading-up {
        opacity: 0;
        transition: opacity var(--sweep);
      }
      .reading:hover .reading-label,
      .reading:focus-visible .reading-label {
        opacity: 0;
      }
      .reading:hover .reading-up,
      .reading:focus-visible .reading-up {
        opacity: 1;
      }
    </style>
  </body>
</html>
