---
import Base from '../layouts/Base.astro';
import MarkerPicker from '../components/MarkerPicker.astro';
import exemples from '../data/exemples.json';
import scrutins from '../data/scrutins.json';
import { APP_URL, COUNTS, DATA_DATE, FUNDING, REPO_URL, STORES } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const first = exemples[0];
const scrutin = scrutins[0];

const LOI_CHOICES = [
  { value: 'contre', label: 'Contre', color: 'var(--vote-m1)' },
  { value: 'abstention', label: 'Abstention', color: 'var(--vote-0)' },
  { value: 'pour', label: 'Pour', color: 'var(--vote-p1)' },
];

// Avis déjà posés dans le cahier : chacun garde la couleur de son trait.
const CAHIER = [
  { tone: 'jaune', vote: 2 },
  { tone: 'rose', vote: -1 },
  { tone: 'vert', vote: 1 },
];
const VALEUR_TONES = ['bleu', 'vert', 'rose', 'jaune'];

const VOTES = [
  { value: -2, label: 'Impossible', sign: '−2', color: 'var(--vote-m2)' },
  { value: -1, label: 'Contre', sign: '−1', color: 'var(--vote-m1)' },
  { value: 1, label: 'Pour', sign: '+1', color: 'var(--vote-p1)' },
  { value: 2, label: 'Parfait', sign: '+2', color: 'var(--vote-p2)' },
];

// Illustration du Classement : scores fictifs, aucun nom ni visage.
const PANELS = [
  { rank: 1, score: 75, tied: true },
  { rank: 1, score: 75, tied: true },
  { rank: 3, score: 67, tied: false },
  { rank: 4, score: 58, tied: true },
  { rank: 4, score: 58, tied: true },
  { rank: 6, score: 50, tied: false },
];

const VALEURS = [
  {
    nom: 'Neutralité',
    cle: 'la mesure',
    titre: 'Vous jugez la mesure, pas la personne.',
    texte: 'Les propositions arrivent sans nom ni parti, dans un ordre mélangé. À égalité de score, les candidats partagent le même rang, dans un ordre tiré au hasard.',
  },
  {
    nom: 'Transparence',
    cle: 'sa source',
    titre: 'Chaque fait a sa source.',
    texte: 'Chaque proposition cite le texte exact de son origine, chaque scrutin renvoie au site officiel du Parlement. Une erreur ? Un lien permet de la signaler.',
  },
  {
    nom: 'Responsabilité',
    cle: 'un vote',
    titre: 'Une promesse n’est pas un vote.',
    texte: 'Le programme 2027 et les votes réels au Parlement sont séparés. Quand un candidat n’a pas voté lui-même, c’est écrit : position de son groupe.',
  },
  {
    nom: 'Confidentialité',
    cle: 'chez vous',
    titre: 'Vos avis restent chez vous.',
    texte: 'Aucun compte, aucune statistique envoyée. Vos votes sont enregistrés sur votre appareil seulement, et vous pouvez les effacer à tout moment.',
  },
];

const keyed = (titre: string, cle: string) => {
  const [avant, apres] = titre.split(cle);
  return { avant, cle, apres };
};

const storesSoon = !STORES.ios || !STORES.android;

// Les vraies questions des testeurs, réponses tirées du fonctionnement de l'app.
const FAQ = [
  {
    question: 'Combien de temps faut-il ?',
    reponse: `Comptez environ 20 secondes par question. Le Classement s'ouvre après 10 votes, soit 3 à 5 minutes ; ensuite, toutes les 10 questions, un bilan dit si votre score est déjà fiable. Vous arrêtez quand vous voulez : vos votes restent sur votre appareil.`,
  },
  {
    question: 'Et si je ne comprends pas une mesure ?',
    reponse: `Touchez « En savoir plus » : le contexte de la mesure et l'explication de ses sigles s'affichent, sans révéler qui l'a proposée. Toujours un doute ? « Je ne sais pas » passe la question sans toucher à votre score.`,
  },
  {
    question: 'Mon score est-il fiable ?',
    reponse: `Chaque score dit sur combien d'éléments il repose : une proposition notée ou un vote personnel compte 1, un vote de groupe ½. Fragile sous 3, assez sûr de 3 à 4,5, fiable à partir de 5. Chaque candidat a 6 propositions : tous peuvent devenir fiables, qu'ils aient siégé au Parlement ou non.`,
  },
  {
    question: 'élire me dit-il pour qui voter ?',
    reponse: `Non. Il calcule de qui vos avis sont proches, sur les seules propositions et les seuls scrutins que vous avez notés. Le reste, programmes complets, débats, convictions, vous appartient.`,
  },
  {
    question: 'Pourquoi tel candidat n’y est pas ?',
    reponse: `élire suit ${COUNTS.candidats} candidats dont la candidature est déclarée ou annoncée publiquement, avec une source. Il en manque un ? Signalez-le sur GitHub : il peut être ajouté dès que sa candidature et ses propositions sont sourcées.`,
  },
  {
    question: 'Qui vérifie les données ?',
    reponse: `Chaque proposition est relue contre sa source, avec la citation exacte. Les votes viennent des données ouvertes de l'Assemblée nationale et des pages officielles du Sénat et du Parlement européen. Dernière vérification le ${DATA_DATE}. Une erreur ? Chaque fiche a son bouton « Signaler une erreur ».`,
  },
  {
    question: 'Mes votes sont-ils envoyés quelque part ?',
    reponse: `Non. Pas de compte, pas de statistiques : vos votes et votre score restent sur votre appareil, et vous pouvez tout effacer depuis le Classement.`,
  },
];
const voteOf = (value: number) => VOTES.find((v) => v.value === value)!;
// Pas un niveau : la question est passée sans compter dans le score.
const UNSURE = { value: 0, label: 'Je ne sais pas', sign: '', color: 'var(--vote-0)' };
---

<Base
  title="élire, présidentielle 2027 : faites-vous votre avis"
  description="Notez les propositions des candidats à l'aveugle, puis comparez-les à leurs votes réels au Parlement. Gratuit, sans compte, open source."
>
  <section class="hero" aria-labelledby="accroche">
    <div class="hook">
      <h1 id="accroche">Faites-vous votre avis. <span class="line">Sans savoir <span class="sweep">qui&nbsp;parle</span>.</span></h1>
      <div class="act">
        <a class="btn" href={APP_URL}>
          Ouvrir l'app web
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <p class="stores">
          {storesSoon ? 'Bientôt sur Android et iOS.' : 'Aussi sur Android et iOS.'}
          <span>Gratuit, sans compte, sans publicité.</span>
        </p>
      </div>
    </div>

    <ol class="sheet" aria-label="Le fonctionnement en quatre temps">
      <li class="col">
        <h2 class="col-title"><span class="num">1.</span> Lire, sans savoir qui</h2>
        <div class="mini-sheet">
          <p class="mini-meta num"><span data-ex-ref>{first.ref}</span> · <span data-ex-theme style={`color:${first.accent}`}>{first.theme}</span></p>
          <p class="mini-title" data-ex-title>{first.titre}</p>
          <p class="mini-source">En savoir plus</p>
        </div>
        <p class="mini-note">Auteur masqué, ordre tiré au hasard.</p>
      </li>

      <li class="col">
        <h2 class="col-title"><span class="num">2.</span> Noter de −2 à +2</h2>
        <p class="mini-title"><span class="mini-mark" data-ex-marked>{first.titre}</span></p>
        <div class="mini-votes" role="group" aria-label="Essai : notez cette mesure">
          {VOTES.map((v) => (
            <button type="button" class="mini-vote num" data-vote={v.value} aria-pressed="false" aria-label={`${v.label} ${v.sign}`} style={`--c:${v.color}`}>{v.sign}</button>
          ))}
        </div>
        <p class="mini-chosen" aria-live="polite"><span class="note">Votre avis :</span> <b data-vote-label>à vous de choisir</b></p>
        <p class="mini-note">Votre note se marque au surligneur, ou « Je ne sais pas ». Les scrutins se votent aussi : contre, abstention, pour.</p>
      </li>

      <li class="col">
        <h2 class="col-title"><span class="num">3.</span> Comparer, à égalité</h2>
        <div class="board" aria-hidden="true">
            {PANELS.map((p) => (
              <span class="panel">
                <b class="rank num">{p.rank}</b>
                <i class="face"></i>
                <i class="name"></i>
                <span class="score num">{p.score} %</span>
              </span>
            ))}
        </div>
        <p class="mini-note">Le même panneau pour tous, ex æquo au même rang. Illustration, noms masqués.</p>
      </li>

      <li class="col">
        <h2 class="col-title"><span class="num">4.</span> Vérifier les votes réels</h2>
        <div class="loi">
            <p class="mini-theme num">L-28 · Assemblée nationale · 4 déc. 2024</p>
            <p class="mini-title">Motion de censure contre le gouvernement Michel Barnier</p>
            <ul class="loi-rows">
              <li><i class="name"></i><span>Pour</span><em>vote personnel</em></li>
              <li><i class="name"></i><span>Contre</span><em>position du groupe</em></li>
            </ul>
            <a class="mini-link" href="https://www.assemblee-nationale.fr/dyn/17/scrutins/0519" rel="noopener"><span class="hl">Scrutin n° 519, site officiel</span></a>
        </div>
        <p class="mini-note">Une promesse n'est pas un vote : c'est écrit.</p>
      </li>
    </ol>

  </section>

  <section id="principe" class="section principe" aria-labelledby="principe-titre">
    <div class="section-body">
      <h2 id="principe-titre">élire vous montre de quels candidats <span class="mark" data-tone="rose">vos idées</span> sont proches. Le choix reste le vôtre.</h2>
      <p class="lede">
        Vous notez des propositions de campagne sans savoir qui les a faites, et vous votez sur de vrais scrutins du Parlement. Ensuite seulement, l'app calcule votre accord avec chaque candidat et vous montre ce qu'ils ont réellement voté.
      </p>
      <p class="facts num">
        <span><b>{COUNTS.candidats}</b> candidats</span>
        <span><b>{COUNTS.propositions}</b> propositions vérifiées</span>
        <span><b>{COUNTS.scrutins}</b> scrutins réels</span>
        <span><b>{COUNTS.themes}</b> thèmes</span>
      </p>
      <p class="fine">Données vérifiées le {DATA_DATE}, chaque proposition contre sa source.</p>
    </div>
  </section>

  <section id="fonctionnement" class="section" aria-labelledby="fonctionnement-titre">
    <div class="section-body">
      <h2 id="fonctionnement-titre">Comment ça <span class="mark" data-tone="vert">marche</span></h2>

      <ol class="temps">
        <li>
          <div>
            <h3><span class="num">1.</span> Lire à l'aveugle</h3>
            <p>Les propositions arrivent une par une, sans nom ni parti, dans un ordre tiré au hasard. Jamais deux fois de suite le même candidat. « En savoir plus » donne le contexte et explique les sigles ; la source est dans Explorer, une fois l'auteur visible.</p>
          </div>
        </li>
        <li>
          <div>
            <h3><span class="num">2.</span> Noter sur quatre niveaux</h3>
            <p>Votre avis, de la mesure inacceptable à la mesure idéale. Il se marque au surligneur et reste modifiable à tout moment. Une mesure que vous ne comprenez pas ou qui vous laisse sans avis : « Je ne sais pas », qui ne compte pas dans le score.</p>
            <ul class="scale" aria-label="Les niveaux de vote">
              {VOTES.map((v) => (
                <li style={`--c:${v.color}`}><b class="num">{v.sign}</b> {v.label}</li>
              ))}
              <li class="scale-unsure">{UNSURE.label}</li>
            </ul>
          </div>
        </li>
        <li>
          <div>
            <h3><span class="num">3.</span> Comparer, à égalité</h3>
            <p>Après 10 votes, le Classement s'ouvre : chaque candidat sur le même panneau numéroté, avec un seul score qui réunit son programme et ses votes. Un candidat est classé dès 2 de ses propositions notées ; deux scores égaux partagent le même rang. Toutes les 10 questions, un bilan dit si chaque score est encore fragile, assez sûr ou fiable.</p>
          </div>
        </li>
        <li>
          <div>
            <h3><span class="num">4.</span> Vérifier les votes réels</h3>
            <p>Chaque fiche candidat sépare le programme 2027 et les votes au Parlement : vote personnel ou position de son groupe, toujours écrit, avec le lien vers le scrutin officiel.</p>
          </div>
        </li>
      </ol>

      <div class="geste">
        <div class="geste-text">
          <h3>Le geste du vote</h3>
          <p>À vous : notez cette proposition. Un trait sur le niveau que vous choisissez, un trait sur la mesure, puis la feuille se range en « Dernier vote » et la suivante arrive. Le trait prend la couleur de votre surligneur.</p>
          <p class="fine">Rien n'est enregistré : c'est un essai, l'app garde vos vrais votes.</p>
        </div>
        <div class="demo" data-demo role="group" aria-label="Essai : notez une proposition">
          <div class="demo-last" aria-hidden="true">
            <span class="demo-last-label note">Dernier vote</span>
            <span class="demo-last-row"><b class="num" data-demo-tag></b><span data-demo-last-title></span></span>
          </div>
          <div class="demo-card">
            <p class="mini-meta num"><span data-da-ref>{first.ref}</span> · <span data-da-theme style={`color:${first.accent}`}>{first.theme}</span></p>
            <p class="mini-title"><span class="demo-sweep" data-da-title>{first.titre}</span></p>
            <div class="mini-votes">
              {VOTES.map((v) => (
                <button type="button" class="mini-vote demo-vote num" data-demo-vote={v.value} aria-label={`${v.label} ${v.sign}`} style={`--c:${v.color}`}><svg class="demo-stroke" aria-hidden="true"><path pathLength="1"></path></svg>{v.sign}</button>
              ))}
            </div>
            <button type="button" class="mini-vote demo-vote demo-unsure" data-demo-vote={UNSURE.value}><svg class="demo-stroke" aria-hidden="true"><path pathLength="1"></path></svg>{UNSURE.label}</button>
            <p class="mini-note">Choisissez un niveau, de −2 à +2, ou « Je ne sais pas ».</p>
          </div>
          <p class="visually-hidden" aria-live="polite" data-demo-status></p>
        </div>
      </div>

      <div class="explorer">
        <figure class="phone">
          <img src={`${base}/images/explorer.webp`} width="390" height="844" alt="L'écran Explorer de l'app : les douze thèmes en sommaire, avec le nombre de propositions notées pour chacun." decoding="async" />
        </figure>
        <div class="explorer-text">
          <h3>Et pour tout parcourir</h3>
          <p>Explorer range les {COUNTS.propositions} propositions par thème, auteurs visibles cette fois. L'onglet Lois liste les {COUNTS.scrutins} scrutins suivis, de l'Assemblée au Parlement européen.</p>
          <ul class="ruled">
            <li>Sommaire des {COUNTS.themes} thèmes, avec vos votes déjà posés</li>
            <li>Recherche sans accents, par mesure ou par candidat</li>
            <li>Filtre « pas encore votées » pour compléter votre cahier</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="parlement" class="section" aria-labelledby="parlement-titre">
    <div class="section-body duo">
      <div class="duo-text">
        <h2 id="parlement-titre">Votez comme <span class="mark" data-tone="bleu">au Parlement</span></h2>
        <p class="lede">Entre deux propositions, un vrai scrutin tombe : la question posée aux élus, sans nom ni résultat. Vous répondez comme eux, contre, abstention ou pour, et ce vote compte dans votre accord avec chaque candidat.</p>
        <ul class="ruled points">
          <li><b class="num">+2</b> pour chaque candidat qui a voté comme vous, <b class="num">−2</b> pour chaque candidat qui a voté l'inverse.</li>
          <li><b class="num">0</b> si le candidat s'est abstenu. Votre abstention, elle, ne compte pour personne.</li>
          <li><b class="num">× 0,5</b> quand seul son groupe a voté, pas le candidat lui-même.</li>
          <li><b>Rien</b> pour un candidat qui ne siégeait pas : ni point en plus, ni point en moins.</li>
        </ul>
      </div>

      <figure class="scrutin" data-scrutin aria-labelledby="scrutin-q">
        <p class="mini-meta num"><span data-sc-ref>{scrutin.ref}</span> · Scrutin · <span data-sc-theme style={`color:${scrutin.accent}`}>{scrutin.theme}</span></p>
        <p id="scrutin-q" class="mini-title" data-sc-q>{scrutin.question}</p>
        <div class="sc-choices" role="group" aria-label="Votre vote sur ce scrutin">
          {LOI_CHOICES.map((c) => (
            <button type="button" class="sc-choice" data-sc-vote={c.value} aria-pressed="false" style={`--c:${c.color}`}><svg class="sc-stroke" aria-hidden="true"><path pathLength="1"></path></svg>{c.label}</button>
          ))}
        </div>
        <div class="hemi" aria-hidden="true">
          <div class="hemi-seats" data-hemi>
          {scrutin.positions.map((_, i) => (
            <i class="seat" data-rel="idle" style={`--a:${180 - (180 * i) / Math.max(1, scrutin.positions.length - 1)}deg;--i:${i}`}></i>
          ))}
          </div>
          <span class="hemi-you" data-hemi-you></span>
        </div>
        <p class="hemi-legend" data-hemi-legend aria-live="polite">{scrutin.positions.length} candidats ont voté ce texte. Votez pour voir où ils siègent par rapport à vous.</p>
        <div class="sc-foot">
          <p class="mini-note">Un vrai scrutin, tiré au hasard. Plein : comme vous. Vide : à l'inverse. Gris : abstention.</p>
          <button type="button" class="link sc-next" data-sc-next><span class="hl">Un autre scrutin</span></button>
        </div>
      </figure>
    </div>
  </section>

  <section id="surligneur" class="section" aria-labelledby="surligneur-titre">
    <div class="section-body duo">
      <div class="duo-text">
        <h2 id="surligneur-titre">Votre <span class="mark">surligneur</span></h2>
        <p class="lede">À la fin de la présentation de l'app, vous choisissez votre couleur parmi quatre. Vous pouvez en changer à tout moment en haut de l’écran Voter : chaque avis garde la couleur du trait qui l'a posé, comme un cahier annoté au fil des semaines.</p>
        <MarkerPicker labels />
        <p class="fine">Ce site prend aussi votre couleur : essayez. Le choix reste sur cet appareil, sans cookie. Aucune couleur ne correspond à un parti.</p>
      </div>

      <figure class="cahier" aria-labelledby="cahier-legende">
        <p id="cahier-legende" class="calc-head">Votre cahier, au fil des votes</p>
        <ol class="cahier-rows" data-cahier>
          {CAHIER.map((c, i) => {
            const e = exemples[i + 2];
            const v = voteOf(c.vote);
            return (
              <li>
                <p class="mini-meta num"><span data-ca-ref>{e.ref}</span> · <span data-ca-theme style={`color:${e.accent}`}>{e.theme}</span></p>
                <p class="cahier-title"><span class="mark" data-tone={c.tone} data-ca-title>{e.titre}</span></p>
                <b class="cahier-vote num" style={`--c:${v.color}`}>{v.label} {v.sign}</b>
              </li>
            );
          })}
          <li class="is-next">
            <p class="mini-meta num"><span data-ca-ref>{exemples[5].ref}</span> · <span data-ca-theme style={`color:${exemples[5].accent}`}>{exemples[5].theme}</span></p>
            <p class="cahier-title"><span class="mark" data-ca-title>{exemples[5].titre}</span></p>
            <b class="cahier-vote">Votre prochain trait</b>
          </li>
        </ol>
      </figure>
    </div>
  </section>

  <section id="valeurs" class="section" aria-labelledby="valeurs-titre">
    <div class="section-body">
      <h2 id="valeurs-titre">Nos <span class="mark" data-tone="jaune">valeurs</span></h2>
      <ul class="valeurs">
        {VALEURS.map((v, i) => {
          const t = keyed(v.titre, v.cle);
          return (
            <li class="valeur">
              <h3>{v.nom}</h3>
              <p class="valeur-lead">
                {t.avant}
                <span class="mark" data-tone={VALEUR_TONES[i]}>{t.cle}</span>
                {t.apres}
              </p>
              <p>{v.texte}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="methode" class="section" aria-labelledby="methode-titre">
    <div class="section-body methode">
      <div>
        <h2 id="methode-titre">Le calcul, <span class="mark" data-tone="rose">en clair</span></h2>
        <p class="lede">Pour chaque candidat, l'app additionne vos notes sur ses propositions, de −2 à +2, et les points de ses scrutins, +2 ou −2, puis ramène la somme sur 0 à 100 %. Sans vote, rien n'est inventé : « pas encore évalué ».</p>
        <ul class="ruled">
          <li>Un vote de groupe compte moitié moins qu'un vote personnel. Un scrutin où le candidat ne siégeait pas n'est pas compté pour lui.</li>
          <li>Les scrutins comptent au nombre, mais jamais plus de la moitié du score : le programme reste la base commune, qu'un candidat ait siégé ou non. <a href="https://github.com/danny-gca/elire-app/tree/main/docs/simulations">La simulation qui a guidé ce choix</a> est publique.</li>
          <li>Le Classement montre un seul score ; la fiche du candidat sépare son programme et ses votes au Parlement.</li>
          <li>« Je ne sais pas » ne compte pas : ni dans le score, ni pour ouvrir le Classement.</li>
          <li>Chaque score dit sa fiabilité : fragile sous 3 éléments, assez sûr de 3 à 4,5, fiable à partir de 5. Une proposition ou un vote personnel compte 1, un vote de groupe ½. Avec 6 propositions chacun, tous les candidats peuvent devenir fiables.</li>
          <li>Le calcul se fait sur votre appareil. Rien n'est envoyé.</li>
          <li>Chaque proposition et chaque scrutin portent un numéro stable (P-531, L-28) pour être cités et corrigés.</li>
          <li>Les couleurs de l'échelle ne servent qu'à vos votes, jamais à un parti.</li>
        </ul>
      </div>

      <figure class="calc" aria-labelledby="calc-legende">
        <p id="calc-legende" class="calc-head">Exemple : 3 propositions et 2 scrutins d'un même candidat</p>
        <table>
          <tbody>
            <tr><th scope="row" class="num">P-412</th><td style="--c:var(--vote-p2)" class="num">Parfait +2</td></tr>
            <tr><th scope="row" class="num">P-087</th><td style="--c:var(--vote-p1)" class="num">Pour +1</td></tr>
            <tr><th scope="row" class="num">P-650</th><td style="--c:var(--vote-m1)" class="num">Contre −1</td></tr>
            <tr class="calc-loi"><th scope="row" class="num">L-12 <span>vote personnel, à l'inverse de vous</span></th><td class="num">−2</td></tr>
            <tr class="calc-loi"><th scope="row" class="num">L-31 <span>vote du groupe, comme vous, × 0,5</span></th><td class="num">+1</td></tr>
          </tbody>
        </table>
        <p class="calc-line num">Somme <b>+1</b> sur une échelle de <b>−9</b> à <b>+9</b></p>
        <p class="calc-result num">Accord <span class="mark" data-tone="bleu">56 %</span></p>
        <p class="calc-formula num">(1 + 9) ÷ 18 = 0,56</p>
