  <!-- En fin de page : tous les blocs tirés au hasard existent déjà. -->
  <script is:inline define:vars={{ exemples, scrutins }}>
    // Geste du surligneur (même tirage que l'app, src/lib/stroke.ts) : droit, diagonal, ondulé ou les deux, toujours de gauche à droite.
    const drawStroke = (button) => {
      const svg = button.querySelector('svg');
      const { width: w, height: h } = button.getBoundingClientRect();
      const r = (min, max) => min + Math.random() * (max - min);
      const kind = Math.floor(Math.random() * 4);
      const diagonal = kind % 2 === 1;
      const wavy = kind >= 2;
      const over = Math.random() < 0.25 ? 0.06 : 0;
      const x0 = r(-0.06, 0.04) - over;
      const x1 = r(0.94, 1.04) + over;
      const yc = r(0.46, 0.6);
      // Pente en hauteur par largeur : plus à plat sur un bouton large.
      const slope = diagonal ? r(0.12, 0.3) * Math.min(1, (1.5 * h) / w) : r(-0.03, 0.03);
      const amp = wavy ? r(0.035, 0.07) : 0;
      const waves = r(1.2, 2.4);
      const phase = Math.random() * Math.PI * 2;
      const pts = [];
      for (let i = 0; i <= 28; i++) {
        const t = i / 28;
        const y = yc - slope * (t - 0.5) + amp * Math.sin(phase + t * waves * Math.PI * 2);
        pts.push(`${((x0 + (x1 - x0) * t) * w).toFixed(1)} ${(y * h).toFixed(1)}`);
      }
      svg.setAttribute('viewBox', `0 0 ${w.toFixed(1)} ${h.toFixed(1)}`);
      const path = svg.querySelector('path');
      path.setAttribute('d', `M${pts.join('L')}`);
      path.style.strokeWidth = `${(r(0.34, 0.46) * h).toFixed(1)}px`;
    };
    // Une proposition et un avis tirés au hasard à chaque visite : aucune mesure n'est mise en avant.
    const ex = exemples[Math.floor(Math.random() * exemples.length)];
    const set = (sel, text) => document.querySelectorAll(sel).forEach((el) => (el.textContent = text));
    set('[data-ex-ref]', ex.ref);
    set('[data-ex-title]', ex.titre);
    set('[data-ex-marked]', ex.titre);
    document.querySelectorAll('[data-ex-theme]').forEach((el) => {
      el.textContent = ex.theme;
      el.style.color = ex.accent;
    });
    const labels = { '-2': 'Impossible −2', '-1': 'Contre −1', '0': 'Je ne sais pas', '1': 'Pour +1', '2': 'Parfait +2' };
    // Colonne 2 : aucune note n'est choisie à la place du visiteur ; son clic pose le trait sur la mesure.
    document.querySelectorAll('[data-vote]').forEach((button) =>
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-vote]').forEach((el) => {
          el.classList.toggle('is-chosen', el === button);
          el.setAttribute('aria-pressed', String(el === button));
        });
        set('[data-vote-label]', labels[button.dataset.vote]);
        document.querySelector('[data-ex-marked]')?.classList.add('is-marked');
      })
    );

    const colors = { '-2': 'var(--vote-m2)', '-1': 'var(--vote-m1)', '0': 'var(--vote-0)', '1': 'var(--vote-p1)', '2': 'var(--vote-p2)' };
    const shuffled = () => [...exemples].sort(() => Math.random() - 0.5);
    const fill = (root, key, e) => {
      root.querySelector(`[data-${key}-ref]`).textContent = e.ref;
      const theme = root.querySelector(`[data-${key}-theme]`);
      theme.textContent = e.theme;
      theme.style.color = e.accent;
      root.querySelector(`[data-${key}-title]`).textContent = e.titre;
    };

    // Cahier : d'autres mesures tirées au hasard.
    const cahier = document.querySelector('[data-cahier]');
    if (cahier) {
      shuffled().slice(0, cahier.children.length).forEach((e, i) => fill(cahier.children[i], 'ca', e));
    }

    // Essai du geste : c'est le visiteur qui note ; trait sur son niveau, trait sur la mesure, la feuille se range.
    const demo = document.querySelector('[data-demo]');
    if (demo) {
      const quick = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const queue = shuffled().filter((e) => e.ref !== demo.querySelector('[data-da-ref]').textContent);
      const buttons = [...demo.querySelectorAll('[data-demo-vote]')];
      const tag = demo.querySelector('[data-demo-tag]');
      const status = demo.querySelector('[data-demo-status]');
      const after = (ms, fn) => setTimeout(fn, quick ? 0 : ms);
      let busy = false;
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          if (busy) return;
          busy = true;
          const value = button.dataset.demoVote;
          const title = demo.querySelector('[data-da-title]').textContent;
          buttons.forEach((b) => (b.disabled = true));
          drawStroke(button);
          button.classList.add('is-picked');
          status.textContent = `Vote noté : ${labels[value]}`;
          // « Je ne sais pas » : pas de trait sur la mesure, aucun avis n'est posé.
          if (value !== '0') after(340, () => demo.classList.add('is-swept'));
          after(860, () => demo.classList.add('is-leaving'));
          after(1260, () => {
            tag.textContent = labels[value];
            tag.style.setProperty('--c', colors[value]);
            demo.querySelector('[data-demo-last-title]').textContent = title;
            const next = queue.shift();
            queue.push(next);
            fill(demo, 'da', next);
            button.classList.remove('is-picked');
            demo.classList.remove('is-swept', 'is-leaving', 'is-entering');
            void demo.offsetWidth;
            demo.classList.add('has-last', 'is-entering');
            buttons.forEach((b) => (b.disabled = false));
            busy = false;
          });
        })
      );
    }

    // Scrutin : les candidats qui l'ont voté prennent place, sans nom, triés comme vous / abstention / à l'inverse.
    const sc = document.querySelector('[data-scrutin]');
    if (sc) {
      const seats = sc.querySelector('[data-hemi]');
      const legend = sc.querySelector('[data-hemi-legend]');
      const you = sc.querySelector('[data-hemi-you]');
      let index = Math.floor(Math.random() * scrutins.length);
      const relation = (user, pos) => (user === 'abstention' || pos === 'abstention' ? 'neutral' : user === pos ? 'same' : 'opposite');
      const rank = { same: 0, neutral: 1, opposite: 2 };
      const plural = (n, w) => `${n} ${w}${n > 1 ? 's' : ''}`;
      const render = (user) => {
        const s = scrutins[index];
        const rels = user ? s.positions.map((p) => relation(user, p)).sort((x, y) => rank[x] - rank[y]) : s.positions.map(() => 'idle');
        seats.replaceChildren(
          ...rels.map((rel, i) => {
            const seat = document.createElement('i');
            seat.className = 'seat';
            seat.dataset.rel = rel;
            seat.style.setProperty('--a', `${180 - (180 * i) / Math.max(1, rels.length - 1)}deg`);
            seat.style.setProperty('--i', String(i));
            return seat;
          })
        );
        sc.querySelectorAll('[data-sc-vote]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.scVote === user)));
        you.textContent = user ? `Vous · ${user[0].toUpperCase()}${user.slice(1)}` : '';
        if (!user) {
          legend.textContent = `${s.positions.length} candidats ont voté ce texte. Votez pour voir où ils siègent par rapport à vous.`;
          return;
        }
        if (user === 'abstention') {
          legend.textContent = 'Abstention : ce texte ne change aucun score.';
          return;
        }
        const n = (r) => rels.filter((x) => x === r).length;
        legend.textContent = [n('same') && `${n('same')} comme vous`, n('opposite') && `${n('opposite')} à l’inverse`, n('neutral') && plural(n('neutral'), 'abstention')]
          .filter(Boolean)
          .join(', ') + '.';
      };
      const load = () => {
        const s = scrutins[index];
        sc.querySelector('[data-sc-ref]').textContent = s.ref;
        const theme = sc.querySelector('[data-sc-theme]');
        theme.textContent = s.theme;
        theme.style.color = s.accent;
        sc.querySelector('[data-sc-q]').textContent = s.question;
        render(null);
      };
      sc.querySelectorAll('[data-sc-vote]').forEach((b) =>
        b.addEventListener('click', () => {
          drawStroke(b);
          render(b.dataset.scVote);
        })
      );
      sc.querySelector('[data-sc-next]')?.addEventListener('click', () => {
        index = (index + 1) % scrutins.length;
        load();
      });
      load();
    }
  </script>
</Base>

