---
import DataPage from '../../components/DataPage.astro';
import { byCandidat, candidatById, enjeux, propositionById, reportUrl, THEME_ACCENTS, themeById, type Proposition } from '../../lib/donnees';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const positionsOf = (positions: { propositionId: string; sens: 'pour' | 'contre' }[]) =>
  positions
    .map((pos) => ({ sens: pos.sens, prop: propositionById.get(pos.propositionId) }))
    .filter((x): x is { sens: 'pour' | 'contre'; prop: Proposition } => x.prop !== undefined)
    .sort((a, b) => byCandidat(a.prop, b.prop));
---

<DataPage
  title="Questions communes · Nos données · élire"
  description="Les questions sur lesquelles plusieurs candidats ont pris position. Une seule note du lecteur compte pour chacun : dans le même sens pour qui propose la mesure, à l'inverse pour qui propose le contraire."
  active="enjeux"
  heading={['Les questions', 'communes']}
  tone="rose"
  csv={[{ href: `${base}/donnees/csv/enjeux.csv`, label: 'Télécharger en CSV' }]}
  search={{ one: 'question', many: 'questions', candidat: true, theme: true }}
>
  <table class="d-table">
    <thead>
      <tr>
        <th scope="col">Réf.</th>
        <th scope="col">Question</th>
        <th scope="col">Thème</th>
        <th scope="col">Propositions liées</th>
      </tr>
    </thead>
    <tbody>
      {enjeux.map((e) => {
        const positions = positionsOf(e.positions);
        return (
          <tr id={e.ref} data-item data-candidat={positions.map((p) => p.prop.candidatId).join(' ')} data-theme={e.thematiqueId}>
            <td class="t-nowrap num">
              <a class="f-ref" href={`#${e.ref}`}><span class="hl">{e.ref}</span></a>
            </td>
            <td class="t-main">
              <p class="t-title">{e.question}</p>
              <p class="t-sub">{e.enjeu}</p>
              <span class="f-actions">
                <a class="link f-report" href={reportUrl(e.ref, e.question)} rel="noopener"><span class="hl">Signaler une erreur</span></a>
              </span>
            </td>
            <td class="t-nowrap" data-label="Thème">
              <span style={`color:${THEME_ACCENTS[e.thematiqueId] ?? 'inherit'}`}>{themeById.get(e.thematiqueId)?.titre}</span>
            </td>
            <td>
              <ul class="t-list">
                {positions.map(({ sens, prop }) => (
                  <li>
                    <b>{candidatById.get(prop.candidatId)?.nom}</b>{' '}
                    <a class="link num" href={`${base}/donnees/propositions/#${prop.ref}`}><span class="hl">{prop.ref}</span></a>
                    {sens === 'contre' && ' (propose le contraire)'}
                  </li>
                ))}
              </ul>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</DataPage>
