---
import DataPage from '../../components/DataPage.astro';
import {
  candidatById,
  enjeuById,
  formatDate,
  plural,
  propositions,
  reportUrl,
  thematiques,
  THEME_ACCENTS,
  TYPE_SOURCE_LABELS,
} from '../../lib/donnees';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = thematiques
  .map((t) => ({ theme: t, items: propositions.filter((p) => p.thematiqueId === t.id) }))
  .filter((g) => g.items.length > 0);
---

<DataPage
  title="Propositions · Nos données · élire"
  description="Chaque proposition de campagne lue dans l'app, avec son auteur, la citation exacte et sa source. Rangées par thème, puis par candidat."
  active="propositions"
  heading={['Les', 'propositions']}
  tone="jaune"
  csv={[{ href: `${base}/donnees/csv/propositions.csv`, label: 'Télécharger en CSV' }]}
  search={{ one: 'proposition', many: 'propositions', candidat: true, theme: true }}
>
  {groups.map(({ theme, items }) => (
    <section class="d-group" data-group aria-labelledby={`t-${theme.id}`}>
      <h2 id={`t-${theme.id}`} style={`color:${THEME_ACCENTS[theme.id] ?? 'inherit'}`}>
        {theme.titre} <small class="num">{plural(items.length, 'proposition')}</small>
      </h2>
      <ul class="d-list">
        {items.map((p) => {
          const c = candidatById.get(p.candidatId);
          const enjeu = p.enjeuId ? enjeuById.get(p.enjeuId) : undefined;
          return (
            <li class="fiche" id={p.ref} data-item data-candidat={p.candidatId} data-theme={p.thematiqueId}>
              <p class="f-meta num">
                <a class="f-ref" href={`#${p.ref}`}><span class="hl">{p.ref}</span></a> · {TYPE_SOURCE_LABELS[p.typeSource] ?? p.typeSource}
                {p.dateDeclaration && <> · {formatDate(p.dateDeclaration)}</>}
              </p>
              <h3>{p.titre}</h3>
              {c && (
                <p class="f-who">
                  <a href={`${base}/donnees/candidats/#${c.id}`}><span class="hl">{c.nom}</span></a> · {c.parti}
                </p>
              )}
              <blockquote class="f-quote" cite={p.sourceUrl}>{p.description}</blockquote>
              <p class="f-text">{p.contexte}</p>
              {enjeu && (
                <p class="f-text">
                  Question commune{' '}
                  <a class="link" href={`${base}/donnees/enjeux/#${enjeu.ref}`}><span class="hl">{enjeu.ref}</span></a>
                  {p.sens === 'contre' ? ' : propose le contraire' : ''}
                </p>
              )}
              <p class="f-actions">
                <a class="link" href={p.sourceUrl} rel="noopener"><span class="hl">Source</span></a>
                <a class="link f-report" href={reportUrl(p.ref, p.titre)} rel="noopener"><span class="hl">Signaler une erreur</span></a>
              </p>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</DataPage>
