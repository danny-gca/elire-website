---
import DataPage from '../../components/DataPage.astro';
import { candidats, partis, reportUrl } from '../../lib/donnees';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<DataPage
  title="Partis · Nos données · élire"
  description="Les partis des candidats, dans l'ordre alphabétique, avec leur nuance officielle à une élection récente, quand elle existe."
  active="partis"
  heading={['Les', 'partis']}
  tone="bleu"
  csv={[{ href: `${base}/donnees/csv/partis.csv`, label: 'Télécharger en CSV' }]}
  search={{ one: 'parti', many: 'partis' }}
>
  <table class="d-table">
    <thead>
      <tr>
        <th scope="col">Parti</th>
        <th scope="col">Sigle</th>
        <th scope="col">Nuance officielle</th>
        <th scope="col">Candidats</th>
        <th scope="col">Liens</th>
      </tr>
    </thead>
    <tbody>
      {partis.map((p) => {
        const membres = candidats.filter((c) => c.partiId === p.id);
        return (
          <tr id={p.id} data-item>
            <td>
              <a class="f-ref t-title" href={`#${p.id}`}><span class="hl">{p.nom}</span></a>
            </td>
            <td class="t-nowrap" data-label="Sigle">{p.sigle ?? '-'}</td>
            <td data-label="Nuance officielle">
              {p.nuanceOfficielle ? (
                <>
                  {p.nuanceOfficielle.libelle} ({p.nuanceOfficielle.code}), {p.nuanceOfficielle.election}.{' '}
                  <a class="link" href={p.nuanceOfficielle.sourceUrl} rel="noopener"><span class="hl">Source</span></a>
                </>
              ) : (
                'Aucune'
              )}
            </td>
            <td data-label={membres.length > 1 ? 'Candidats' : 'Candidat'}>
              {membres.length === 0
                ? 'Aucun'
                : membres.map((c, i) => (
                    <>
                      {i > 0 && ', '}
                      <a class="link" href={`${base}/donnees/candidats/#${c.id}`}><span class="hl">{c.nom}</span></a>
                    </>
                  ))}
            </td>
            <td>
              <span class="f-actions t-stack">
                {p.siteWeb && <a class="link" href={p.siteWeb} rel="noopener"><span class="hl">Site du parti</span></a>}
                <a class="link f-report" href={reportUrl(p.id, p.nom)} rel="noopener"><span class="hl">Signaler une erreur</span></a>
              </span>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</DataPage>
