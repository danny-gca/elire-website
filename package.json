{
  "name": "elire-website",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-dataset": "node scripts/fetch-dataset.mjs",
    "predev": "npm run fetch-dataset",
    "dev": "astro dev",
    "prebuild": "npm run fetch-dataset",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run fetch-dataset",
    "check": "astro check && astro build",
    "test": "node --test \"src/**/*.test.mjs\" \"scripts/*.test.mjs\" && npm run test:build",
    "pretest:build": "npm run build",
    "test:build": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
